# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value is optional: with none of them
# set, the portal runs on the dev-bypass identity and still works end to end.
# ---------------------------------------------------------------------------

# Clerk. Set BOTH to switch from the dev bypass to real authentication.
# Get them from https://dashboard.clerk.com -> your app -> API keys.
#
# Organizations must be enabled in the Clerk dashboard: one organization per
# legal entity, with client members invited as org:admin (portal "owner") or
# org:member (portal "member"). See README for the full setup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Environment banner across the top of every page.
NEXT_PUBLIC_ENV_LABEL=DEV ENVIRONMENT
# Defaults to today's date (YYYY.MM.DD) when unset.
NEXT_PUBLIC_BUILD_ID=

# Where the "Start New RFS" buttons point. Placeholder until RFS Next has a
# real URL for this environment.
NEXT_PUBLIC_RFS_NEXT_URL=https://rfs.boasafraag.example/rfs

# Artificial delay (ms) on every mock data read, to demo the loading skeletons.
MOCK_LATENCY_MS=0
